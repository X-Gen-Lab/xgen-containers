@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/xgenContainersCompatibility.cmake")
set(xgen_containers_VERSION "@PROJECT_VERSION@")
set(_xgct_available "@XGCT_COMPONENTS@")
set(_xgct_requested "${xgen_containers_FIND_COMPONENTS}")
if(NOT _xgct_requested)
    set(_xgct_requested "${_xgct_available}")
endif()
foreach(_xgct_component IN LISTS _xgct_requested)
    set(xgen_containers_${_xgct_component}_FOUND FALSE)
    if(NOT _xgct_component IN_LIST _xgct_available)
        set(xgen_containers_NOT_FOUND_MESSAGE "Component '${_xgct_component}' is not installed")
        continue()
    endif()
    if(NOT _xgct_component STREQUAL "list")
        find_dependency(xgen_status 0.1.0 EXACT CONFIG COMPONENTS status)
    endif()
    if(NOT TARGET xgct::${_xgct_component})
        include("${CMAKE_CURRENT_LIST_DIR}/xgenContainers-${_xgct_component}-targets.cmake")
    endif()
    xgct_check_target(xgct::${_xgct_component} STATIC_LIBRARY "@PROJECT_VERSION@" _xgct_error)
    if(_xgct_error)
        set(xgen_containers_NOT_FOUND_MESSAGE "${_xgct_error}")
        set(xgen_containers_FOUND FALSE)
        return()
    endif()
    set(xgen_containers_${_xgct_component}_FOUND TRUE)
endforeach()
check_required_components(xgen_containers)
unset(_xgct_available)
unset(_xgct_requested)
unset(_xgct_component)
unset(_xgct_error)
